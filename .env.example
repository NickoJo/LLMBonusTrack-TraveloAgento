# ============================================================
# TraveloAgento — environment configuration
# Copy to .env and fill in your values
# ============================================================

# --- Required ---
DEEPSEEK_API_KEY=sk-your-key-here

# --- LLM ---
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.3
ITINERARY_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- Limits ---
MAX_LLM_CALLS=30
TOOL_TIMEOUT_SEC=5
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MIN=30

# --- RAG ---
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.6
KB_DIR=data/travel_kb/cities
KB_INDEX_DIR=data/travel_kb/index

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/travelo.jsonl

# --- Airbnb: реальный MCP-сервер ---
# true  — использовать @openbnb/mcp-server-airbnb (нужен Node.js + npx)
# false — mock-фикстуры из data/mocks/ (по умолчанию)
USE_REAL_AIRBNB_MCP=false
MCP_AIRBNB_TIMEOUT_SEC=30

# --- Demo flags: MCP failure simulation ---
MOCK_BOOKING_FAIL=false
MOCK_AIRBNB_FAIL=false
MOCK_FLIGHTS_DELAY_SEC=0
